# Development
ASPNETCORE_ENVIRONMENT=Development
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43121
NEXT_PUBLIC_ADMIN_URL=http://127.0.0.1:43122
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:43130

# Local API database (Phase 1). Override in apps/api/.env for real credentials.
# ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=bangalore_taxi;Username=bangalore_taxi;Password=dev

# Public site indexing (apps/web). Unset/false on development, testing, staging, and preview.
# INDEX_PUBLIC=true

# Auth (API). Production only — never commit real values.
# Auth__Otp__Pepper=
# Auth__Jwt__SigningKey=
# Cors__AllowedOrigins__0=https://www.example.com
# ForwardedHeaders__KnownProxies__0=

# Staging / Production — populate in the host, never in git
# ConnectionStrings__DefaultConnection=
# Maps__ApiKey=
# Notification__WhatsAppApiKey=
# Notification__SmsApiKey=
# Notification__SmtpPassword=
