# Copy to .env or set as environment variables. Never commit real values.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:43130

# Local PostgreSQL (see docs/database/local-setup.md). Do not commit real production credentials.
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=bangalore_taxi;Username=bangalore_taxi;Password=dev

# Comma-separated origins are not used; configure Cors:AllowedOrigins in appsettings or:
Cors__AllowedOrigins__0=http://127.0.0.1:43121
Cors__AllowedOrigins__1=http://127.0.0.1:43122
