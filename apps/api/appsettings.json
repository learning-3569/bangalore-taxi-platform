{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Operations": {
    "AssignmentBufferMinutes": 15,
    "DefaultTripDurationMinutes": 120,
    "DefaultTimeZone": "Asia/Kolkata",
    "DefaultCurrencyCode": "INR"
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Auth": {
    "RefreshTokenDays": 14,
    "Otp": {
      "Length": 6,
      "ExpirySeconds": 300,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "MaxRequestsPerHour": 5,
      "Pepper": "",
      "Provider": "Unconfigured"
    },
    "Jwt": {
      "Issuer": "bangalore-taxi-api",
      "Audience": "bangalore-taxi-clients",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "Cookie": {
      "RefreshName": "bt_refresh",
      "CsrfName": "bt_csrf",
      "Path": "/api/v1/auth",
      "SameSite": "Lax"
    }
  }
}
